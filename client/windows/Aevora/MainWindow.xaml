<Window x:Class="Aevora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aevora VPN" Height="760" Width="480"
        Background="#1A1B2E" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E1F0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2E4A"/>
            <Setter Property="Foreground" Value="#E0E1F0"/>
            <Setter Property="BorderBrush" Value="#444680"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#2D2E4A"/>
            <Setter Property="Foreground" Value="#E0E1F0"/>
            <Setter Property="BorderBrush" Value="#444680"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Aevora" FontSize="32" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="&#x2022;" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AevoraTeal}" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Enroll Panel (shown when not enrolled) -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="340"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsEnrolled, Converter={StaticResource InverseBoolToVis}}"
                    x:Name="EnrollPanel">
            <Border Background="#2D2E4A" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Enroll this device" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,16" Foreground="White"/>
                    <TextBlock Text="Invite code" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                    <TextBox x:Name="InviteBox" Margin="0,0,0,12"/>
                    <TextBlock Text="Email address" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                    <TextBox x:Name="EmailBox" Margin="0,0,0,16"/>
                    <Button Content="Enroll Device" Click="OnEnroll"
                            Background="{StaticResource AevoraTeal}" Foreground="White"
                            Height="42" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main VPN Panel (shown when enrolled) -->
        <StackPanel Grid.Row="1" x:Name="MainPanel"
                    Visibility="{Binding IsEnrolled, Converter={StaticResource BoolToVis}}">

            <!-- World Map Canvas -->
            <Border BorderBrush="#333666" BorderThickness="1" CornerRadius="10"
                    Height="160" Margin="0,0,0,14" Background="#0D0E1F">
                <Canvas x:Name="MapCanvas" ClipToBounds="True"/>
            </Border>

            <!-- VPN Status Card -->
            <Border Background="#2D2E4A" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DIRECT MODE" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{StaticResource AevoraTeal}"
                               Margin="0,0,0,6"
                               Visibility="{Binding IsDirectMode, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StateText}" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ServerName}" HorizontalAlignment="Center"
                               Foreground="#8B8FBF" Margin="0,0,0,14"/>
                    <Button x:Name="ConnectButton" Click="OnConnectToggle" Height="48"
                            Background="{StaticResource AevoraTeal}" Foreground="White"
                            Content="Connect" FontSize="15"/>
                    <!-- Live stats (visible only when connected) -->
                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Duration" Foreground="#8B8FBF" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Duration}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Latency"  Foreground="#8B8FBF" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Latency}"  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Download" Foreground="#8B8FBF" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Download}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Upload"   Foreground="#8B8FBF" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Upload}"   Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Location selection list -->
            <TextBlock Text="Select Location" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#E0E1F0"
                       Visibility="{Binding IsDirectMode, Converter={StaticResource InverseBoolToVis}}"/>
            <ListBox x:Name="LocationsList" Height="160"
                     ItemsSource="{Binding Locations}" SelectionChanged="OnLocationSelected"
                     Background="#2D2E4A" BorderBrush="#444680"
                     Visibility="{Binding IsDirectMode, Converter={StaticResource InverseBoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#E0E1F0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#444680"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock Text="{Binding Country}" Foreground="#E0E1F0"/>
                            <TextBlock DockPanel.Dock="Right" Text="unavailable"
                                       Foreground="#666" FontSize="10"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding Available, Converter={StaticResource InverseBoolToVis}}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Public IP display -->
        <Border Grid.Row="2" Background="#2D2E4A" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="Public IP:" Foreground="#8B8FBF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding PublicIp}" FontWeight="SemiBold"
                           Foreground="{StaticResource AevoraTeal}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Error display -->
        <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="#E74C3C"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>
