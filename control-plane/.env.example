# Copy to .env for local runs outside docker-compose. Do NOT commit real values.
AEVORA_LISTEN_ADDR=:8080
AEVORA_DB_URL=postgres://aevora:aevora@localhost:5432/aevora?sslmode=disable
AEVORA_DEV_SEED=1

# Auth — leave empty to DISABLE the feature (secure default):
#   empty AEVORA_ENROLLMENT_SECRET => gateway registration is refused (503)
#   empty AEVORA_ADMIN_TOKEN       => admin views (gateway list, invites) hidden (404)
#   empty AEVORA_JWT_SECRET        => user auth (enroll/refresh/devices) disabled (503)
# Set strong random values in real deployments. Never commit them.
AEVORA_ENROLLMENT_SECRET=
AEVORA_ADMIN_TOKEN=
AEVORA_JWT_SECRET=

# A gateway is considered offline once its heartbeat is older than this;
# the reaper sweeps at REAPER_INTERVAL.
AEVORA_HEARTBEAT_TTL=30s
AEVORA_REAPER_INTERVAL=10s

# User token lifetimes: short access JWT, long refresh token.
AEVORA_ACCESS_TTL=15m
AEVORA_REFRESH_TTL=720h
