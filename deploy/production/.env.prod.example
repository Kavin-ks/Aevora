# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
# Generate strong random secrets, e.g.:  openssl rand -base64 32

# Public hostname Caddy serves TLS for (must resolve to this host).
AEVORA_DOMAIN=control.example.com

# PostgreSQL password (used by both postgres and controld's DB URL).
POSTGRES_PASSWORD=

# Signs user access JWTs. Rotate carefully (invalidates live access tokens).
AEVORA_JWT_SECRET=

# Secret gateways present to self-register. Give ONLY to gateway operators —
# never to clients.
AEVORA_ENROLLMENT_SECRET=

# Bearer for admin endpoints (mint invites, list fleet). Keep private.
AEVORA_ADMIN_TOKEN=

# DNS resolver(s) pushed to connected clients (comma-separated).
AEVORA_CLIENT_DNS=9.9.9.9,149.112.112.112
