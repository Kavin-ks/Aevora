# Copy to /etc/aevora/agent.env (chmod 600) and edit. Never commit the real file.
AEVORA_CONTROL_URL=https://control.example.com

# Only needed for the FIRST registration; the node token is then cached at
# AEVORA_NODE_TOKEN_FILE. Remove after enrollment if you prefer.
AEVORA_ENROLLMENT_SECRET=
AEVORA_NODE_TOKEN_FILE=/etc/aevora/node.token

# Interfaces.
AEVORA_WG_INTERFACE=wg0
AEVORA_WAN_INTERFACE=eth0

# Gateway identity + metadata (advertised to the control plane).
AEVORA_GATEWAY_NAME=de-fra-1
AEVORA_COUNTRY_CODE=de
AEVORA_COUNTRY_NAME=Germany
AEVORA_CITY=Frankfurt
AEVORA_REGION=eu-central
AEVORA_ENDPOINT_HOST=203.0.113.9
AEVORA_ENDPOINT_PORT=51820
AEVORA_WG_SUBNET_V4=10.7.1.0/24
AEVORA_WG_SUBNET_V6=fd07:0007:1::/64
AEVORA_CAPACITY=250
AEVORA_BANDWIDTH_MBPS=1000

AEVORA_SYNC_INTERVAL=3s
