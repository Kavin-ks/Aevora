# Aevora gateway configuration — copy to config.env and edit.
# Sourced by bootstrap.sh, add-peer.sh, remove-peer.sh, validate.sh.
# Provider-agnostic: works on any Debian/Ubuntu VPS (Hetzner, Vultr, DO, EC2, ...).

# WireGuard interface name.
WG_INTERFACE="wg0"

# UDP port the gateway listens on. 51820 is the WireGuard default.
SERVER_PORT="51820"

# Tunnel subnets. The gateway takes .1; clients are leased from the rest.
# IPv6 uses a ULA range so it works without provider IPv6.
WG_SUBNET_V4="10.7.0.0/24"
WG_SUBNET_V6="fd07:0007::/64"

# DNS the client is told to use while connected (leak-free: resolved in-tunnel).
# Phase 0 shortcut: a trusted public resolver. Phase 2+ replaces this with a
# gateway-local unbound listening on the gateway's tunnel IP.
CLIENT_DNS="9.9.9.9, 149.112.112.112"

# Tunnel MTU. 1420 = 1500 - WireGuard overhead; avoids fragmentation.
CLIENT_MTU="1420"

# Keep NAT mappings warm so reconnection is instant (seconds).
CLIENT_KEEPALIVE="25"

# Public endpoint clients dial. Leave blank to auto-detect the public IP.
# Set to a hostname once you have DNS (e.g. de1.gw.example.com).
PUBLIC_ENDPOINT=""

# Primary (WAN) interface for NAT egress. Leave blank to auto-detect the
# interface behind the default route.
WAN_INTERFACE=""
